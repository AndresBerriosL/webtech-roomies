<section class="bg-light py-5">
  <div class="container py-5 text-center">
    <h1 class="display-4 fw-bold">
      Find a room that feels like home
    </h1>

    <p class="lead text-muted mx-auto mb-4" style="max-width: 700px;">
      Discover rooms, explore neighborhoods, and find the right place
      and people to live with.
    </p>

    <%= link_to "Browse rooms",
                listings_path,
                class: "btn btn-primary btn-lg" %>
  </div>
</section>

<section class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Available rooms</h2>

    <%= link_to "View all",
                listings_path,
                class: "btn btn-outline-primary" %>
  </div>

  <% if @listings.any? %>
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <%= render partial: "listings/listing_card",
                 collection: @listings,
                 as: :listing %>
    </div>
  <% else %>
    <div class="alert alert-info">
      There are no published rooms yet.
    </div>
  <% end %>
</section>

<section class="bg-light py-5">
  <div class="container">
    <h2 class="text-center mb-5">How Roomies works</h2>

    <div class="row text-center g-4">
      <div class="col-md-4">
        <h3 class="h5">1. Explore</h3>
        <p class="text-muted">
          Browse available rooms and neighborhoods.
        </p>
      </div>

      <div class="col-md-4">
        <h3 class="h5">2. Apply</h3>
        <p class="text-muted">
          Send an application to the rooms you like.
        </p>
      </div>

      <div class="col-md-4">
        <h3 class="h5">3. Meet</h3>
        <p class="text-muted">
          Schedule a visit and meet your potential roomies.
        </p>
      </div>
    </div>
  </div>
</section>