
<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Amenities</h1>

    <%= link_to "New Amenity",
                new_amenity_path,
                class: "btn btn-primary" %>
  </div>

  <% if @amenities.any? %>
    <div class="list-group">
      <% @amenities.each do |amenity| %>
        <%= link_to amenity_path(amenity),
                    class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>

          <span><%= amenity.name %></span>

          <span class="badge text-bg-primary rounded-pill">
            <%= amenity.properties.size %> properties
          </span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      There are no amenities registered.
    </div>
  <% end %>
</div>
