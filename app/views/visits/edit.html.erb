
<div class="container py-5">
  <h1>Reschedule visit</h1>

  <p class="text-muted">
    Candidate: <%= @application.seeker.name %>
  </p>

  <p>
    <strong>Property:</strong>
    <%= @application.listing.property.address %>
  </p>

  <%= form_with model: @visit,
                url: visit_path(@visit),
                method: :patch do |form| %>

    <% if @visit.errors.any? %>
      <div class="alert alert-danger">
        <% @visit.errors.full_messages.each do |error| %>
          <p class="mb-1"><%= error %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :scheduled_at,
                    "New date and time",
                    class: "form-label" %>

      <%= form.datetime_local_field :scheduled_at,
                                    class: "form-control",
                                    min: Time.current.strftime("%Y-%m-%dT%H:%M"),
                                    required: true %>
    </div>

    <%= form.submit "Save new date",
                    class: "btn btn-primary" %>

    <%= link_to "Cancel",
                visit_path(@visit),
                class: "btn btn-outline-secondary ms-2" %>
  <% end %>
</div>
