<div class="container py-5">
  <h1 class="mb-4">Applications</h1>

  <% if @applications.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Seeker</th>
            <th>Listing</th>
            <th>Neighborhood</th>
            <th>Move-in date</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @applications.each do |application| %>
            <tr>
              <td><%= application.seeker.name %></td>

              <td>
                <%= number_to_currency(
                      application.listing.monthly_rent,
                      unit: "$",
                      precision: 0
                    ) %>
              </td>

              <td>
                <%= application.listing.property.neighborhood.name %>
              </td>

              <td>
                <%= application.move_in_date.strftime("%d/%m/%Y") %>
              </td>

              <td>
                <span class="badge text-bg-secondary">
                  <%= application.status.humanize %>
                </span>
              </td>

              <td>
                <%= link_to "View",
                            application_path(application),
                            class: "btn btn-sm btn-outline-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      There are no applications yet.
    </div>
  <% end %>
</div>