<div class="container py-5">
  <%= link_to "← Back to applications",
              applications_path,
              class: "btn btn-outline-secondary mb-4" %>

  <h1>Application</h1>

  <% if @application.listing.property.host == current_user &&
      @application.shortlisted? &&
      @application.listing.published? &&
      !@application.visits.where(status: [:proposed, :confirmed]).exists? %>

    <div class="my-3">
      <%= link_to "Propose visit",
                  new_application_visit_path(@application),
                  class: "btn btn-primary" %>
    </div>

  <% end %>

  <% if @application.seeker == current_user &&
        (@application.pending? || @application.shortlisted?) %>

    <div class="my-4">
      <%= button_to "Withdraw application",
            withdraw_application_path(@application),
            method: :patch,
            class: "btn btn-outline-danger",
            form: {
              data: {
                turbo_confirm: "Are you sure you want to withdraw?"
              }
            } %>
    </div>

  <% end %>

  
<% if @application.listing.property.host == current_user &&
      @application.listing.published? %>

  <div class="d-flex gap-2 my-4">

    <% if @application.pending? %>
      <%= button_to "Shortlist",
            shortlist_application_path(@application),
            method: :patch,
            class: "btn btn-warning" %>
    <% end %>

    <% if @application.pending? || @application.shortlisted? %>

      <%= button_to "Accept",
            accept_application_path(@application),
            method: :patch,
            class: "btn btn-success",
            form: {
              data: {
                turbo_confirm: "Accept this candidate and reserve the room?"
              }
            } %>

      <%= button_to "Reject",
            reject_application_path(@application),
            method: :patch,
            class: "btn btn-danger",
            form: {
              data: {
                turbo_confirm: "Reject this application?"
              }
            } %>

    <% end %>

  </div>
<% end %>


  <div class="row g-4 mt-2">
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="h4">Application details</h2>

          <p>
            <strong>Seeker:</strong>
            <%= @application.seeker.name %>
          </p>

          <p>
            <strong>Status:</strong>
            <span class="badge text-bg-secondary">
              <%= @application.status.humanize %>
            </span>
          </p>

          <p>
            <strong>Move-in date:</strong>
            <%= @application.move_in_date.strftime("%d/%m/%Y") %>
          </p>

          <p>
            <strong>Intended stay:</strong>
            <%= @application.intended_stay %> months
          </p>

          <p>
            <strong>Message:</strong>
          </p>

          <p><%= @application.message %></p>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="h4">Listing</h2>

          <p>
            <strong>Neighborhood:</strong>
            <%= @application.listing.property.neighborhood.name %>
          </p>

          <p>
            <strong>Address:</strong>
            <%= @application.listing.property.address %>
          </p>

          <p>
            <strong>Monthly rent:</strong>
            <%= number_to_currency(
                  @application.listing.monthly_rent,
                  unit: "$",
                  precision: 0
                ) %>
          </p>

          <%= link_to "View listing",
                      listing_path(@application.listing),
                      class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-5">
    <h2>Visits</h2>

    <% if @application.visits.any? %>
      <% @application.visits.each do |visit| %>
        <div class="card mb-3">
          <div class="card-body">
            <p class="mb-1">
              <strong>Date:</strong>
              <%= visit.scheduled_at.strftime("%d/%m/%Y %H:%M") %>
            </p>

            <p class="mb-0">
              <strong>Status:</strong>
              <%= visit.status.humanize %>
            </p>
            <div class="mt-3">
              <%= link_to "View visit",
                          visit_path(visit),
                          class: "btn btn-sm btn-outline-primary" %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted">
        No visits have been scheduled for this application.
      </p>
    <% end %>
  </section>
</div>