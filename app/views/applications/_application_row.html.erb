
<tr id="<%= dom_id(application) %>">
  <td><%= application.seeker.name %></td>

  <td>
    <%= number_to_currency(
          application.listing.monthly_rent,
          unit: "$",
          precision: 0
        ) %>
  </td>

  <td><%= application.listing.property.neighborhood.name %></td>

  <td><%= application.move_in_date.strftime("%d/%m/%Y") %></td>

  <td>
    <span class="badge text-bg-secondary">
      <%= application.status.humanize %>
    </span>
  </td>

  <td>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "View",
            application_path(application),
            class: "btn btn-sm btn-outline-primary" %>

      <% if application.listing.property.host_id == current_user.id &&
            application.listing.published? %>

        <% if application.pending? %>
          <%= button_to "Shortlist",
                shortlist_application_path(application),
                method: :patch,
                class: "btn btn-sm btn-warning" %>
        <% end %>

        <% if application.pending? || application.shortlisted? %>
          <%= button_to "Reject",
                reject_application_path(application),
                method: :patch,
                class: "btn btn-sm btn-danger" %>
        <% end %>

      <% end %>
    </div>
  </td>
</tr>
