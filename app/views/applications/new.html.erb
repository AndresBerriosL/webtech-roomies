<%= turbo_frame_tag "application_form" do %>
<div class="container py-5">
  <h1>Apply for this room</h1>

  <div class="alert alert-info mt-4">
    <strong>Property:</strong>
    <%= @listing.property.address %>

    <br>

    <strong>Monthly rent:</strong>
    <%= number_to_currency(
          @listing.monthly_rent,
          unit: "$",
          precision: 0
        ) %>
  </div>

  <%= form_with model: @application,
              url: applications_path,
              data: { turbo_frame: "_top" } do |form| %>

    <%= form.hidden_field :listing_id,
          value: @listing.id %>

    <% if @application.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% @application.errors.full_messages.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :message,
            "Message to the host",
            class: "form-label" %>

      <%= form.text_area :message,
            class: "form-control",
            rows: 5,
            required: true,
            placeholder: "Introduce yourself..." %>
    </div>

    <div class="mb-3">
      <%= form.label :move_in_date,
            "Move-in date",
            class: "form-label" %>

      <%= form.date_field :move_in_date,
            class: "form-control",
            min: Date.current,
            required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :intended_stay,
            "Intended stay (months)",
            class: "form-label" %>

      <%= form.number_field :intended_stay,
            class: "form-control",
            min: 1,
            required: true %>
    </div>

    <div class="d-flex gap-2">
      <%= form.submit "Submit application",
            class: "btn btn-primary" %>

      <%= link_to "Cancel",
            listing_path(@listing),
            class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
<% end %>
