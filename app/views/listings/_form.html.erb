
<%= form_with model: listing,
              url: listing.new_record? ?
                   property_listings_path(property) :
                   listing_path(listing) do |form| %>

  <% if listing.errors.any? %>
    <div class="alert alert-danger">
      <h5>Please correct the following errors:</h5>
      <ul class="mb-0">
        <% listing.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :monthly_rent, class: "form-label" %>
      <%= form.number_field :monthly_rent,
            class: "form-control",
            min: 1,
            step: 1,
            required: true %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :deposit, class: "form-label" %>
      <%= form.number_field :deposit,
            class: "form-control",
            min: 0,
            step: 1,
            required: true %>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= form.label :availability_date, class: "form-label" %>
      <%= form.date_field :availability_date,
            class: "form-control",
            min: Date.current,
            required: true %>
    </div>

    <div class="col-md-6 mb-3">
      <%= form.label :minimum_stay, "Minimum stay (months)",
            class: "form-label" %>
      <%= form.number_field :minimum_stay,
            class: "form-control",
            min: 1,
            required: true %>
    </div>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :furnished, class: "form-check-input" %>
    <%= form.label :furnished, class: "form-check-label" %>
  </div>

  <div class="form-check mb-3">
    <%= form.check_box :private_bathroom, class: "form-check-input" %>
    <%= form.label :private_bathroom, class: "form-check-label" %>
  </div>

  <div class="mb-4">
    <%= form.label :description, class: "form-label" %>
    <%= form.rich_text_area :description,
          class: "form-control",
          required: true,
          placeholder: "Describe the room..." %>
  </div>

  <div class="mb-4">
    <%= form.label :house_rules, "House rules", class: "form-label" %>
    <%= form.rich_text_area :house_rules,
            class: "form-control",
            placeholder: "Describe the house rules..." %>
    </div>

    <div class="mb-4">
    <%= form.label :photos, "Room photographs", class: "form-label" %>

    <%= form.file_field :photos,
            multiple: true,
            accept: "image/jpeg,image/png,image/webp",
            class: "form-control" %>

    <div class="form-text">
        Select multiple photographs. Maximum 5 MB per image.
        JPG, PNG or WebP only.
    </div>
    </div>


  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>

    <%= link_to "Cancel",
                property_path(property),
                class: "btn btn-outline-secondary" %>
  </div>
<% end %>
