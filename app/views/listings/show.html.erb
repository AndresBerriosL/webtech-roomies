<div class="container py-5">
  <%= link_to "← Back to listings",
              listings_path,
              class: "btn btn-outline-secondary mb-4" %>

  <div class="row g-4">
    <div class="col-lg-8">
      <h1>Room in <%= @listing.property.neighborhood.name %></h1>

      <p class="lead">
        <%= @listing.description %>
      </p>

      <hr>

      <h3>Room details</h3>

      <dl class="row">
        <dt class="col-sm-4">Monthly rent</dt>
        <dd class="col-sm-8">
          <%= number_to_currency(@listing.monthly_rent, unit: "$", precision: 0) %>
        </dd>

        <dt class="col-sm-4">Deposit</dt>
        <dd class="col-sm-8">
          <%= number_to_currency(@listing.deposit, unit: "$", precision: 0) %>
        </dd>

        <dt class="col-sm-4">Available from</dt>
        <dd class="col-sm-8"><%= @listing.availability_date.strftime("%d/%m/%Y") %></dd>

        <dt class="col-sm-4">Minimum stay</dt>
        <dd class="col-sm-8"><%= @listing.minimum_stay %> months</dd>

        <dt class="col-sm-4">Furnished</dt>
        <dd class="col-sm-8"><%= @listing.furnished? ? "Yes" : "No" %></dd>

        <dt class="col-sm-4">Private bathroom</dt>
        <dd class="col-sm-8"><%= @listing.private_bathroom? ? "Yes" : "No" %></dd>

        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8"><%= @listing.status.humanize %></dd>
      </dl>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h3 class="h5">Property</h3>

          <p><strong>Address:</strong> <%= @listing.property.address %></p>
          <p><strong>Type:</strong> <%= @listing.property.property_type %></p>
          <p><strong>Bedrooms:</strong> <%= @listing.property.bedrooms %></p>
          <p><strong>Bathrooms:</strong> <%= @listing.property.bathrooms %></p>

          <%= link_to "View property",
                      property_path(@listing.property),
                      class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-5">
    <h2>Amenities</h2>

    <% if @listing.property.amenities.any? %>
      <div class="d-flex flex-wrap gap-2">
        <% @listing.property.amenities.each do |amenity| %>
          <span class="badge text-bg-secondary">
            <%= amenity.name %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted">No amenities registered.</p>
    <% end %>
  </section>

  <section class="mt-5">
    <h2>Property reviews</h2>

    <% if @reviews.any? %>
      <% @reviews.each do |review| %>
        <div class="card mb-3">
          <div class="card-body">
            <h5>
              <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
            </h5>

            <p><%= review.comment %></p>

            <small class="text-muted">
              <%= review.visit.application.seeker.name %>
            </small>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted">This property has no reviews yet.</p>
    <% end %>
  </section>
</div>