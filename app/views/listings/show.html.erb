<div class="container py-5">

  
  <% if @listing.property.host == current_user %>
    <div class="d-flex gap-2 mb-4">

      <%= link_to "Edit Listing",
                  edit_listing_path(@listing),
                  class: "btn btn-warning" %>

      <% unless @listing.applications.exists? %>
        <%= button_to "Delete Listing",
                      listing_path(@listing),
                      method: :delete,
                      class: "btn btn-danger",
                      form: {
                        data: {
                          turbo_confirm: "Are you sure you want to delete this listing?"
                        }
                      } %>
      <% end %>

    </div>
  <% end %>

  
  <% if @listing.property.host == current_user && @listing.draft? %>
    <div class="mb-4">
      <%= button_to "Publish Listing",
                    publish_listing_path(@listing),
                    method: :patch,
                    class: "btn btn-success",
                    form: {
                      data: {
                        turbo_confirm: "Publish this listing?"
                      }
                    } %>
    </div>
  <% end %>

  
  <% if @listing.property.host == current_user && @listing.published? %>
    <div class="mb-4">
      <%= button_to "Withdraw Listing",
                    withdraw_listing_path(@listing),
                    method: :patch,
                    class: "btn btn-outline-danger",
                    form: {
                      data: {
                        turbo_confirm: "Withdraw this listing?"
                      }
                    } %>
    </div>
  <% end %>


  <%= link_to "← Back to listings",
              listings_path,
              class: "btn btn-outline-secondary mb-4" %>

  <div class="row g-4">
    <div class="col-lg-8">
      
<h1>Room in <%= @listing.property.neighborhood.name %></h1>

  <section class="my-4">
    <h2 class="h4">Description</h2>

    <div class="lead">
      <%= @listing.description %>
    </div>
  </section>

  <% if @listing.house_rules.present? %>
    <section class="my-4">
      <h2 class="h4">House rules</h2>

      <div>
        <%= @listing.house_rules %>
      </div>
    </section>
  <% end %>

  <% if @listing.photos.attached? %>

        <section class="my-4">
          <h2 class="h4 mb-3">Room photographs</h2>

          <div class="row g-3">
            <% @listing.photos.each do |photo| %>
              <div class="col-md-6">
                <%= image_tag photo,
                      class: "img-fluid rounded shadow-sm",
                      style: "width: 100%; height: 260px; object-fit: cover;" %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>


      <hr>

      <h3>Room details</h3>

      <dl class="row">
        <dt class="col-sm-4">Monthly rent</dt>
        <dd class="col-sm-8">
          <%= number_to_currency(@listing.monthly_rent, unit: "$", precision: 0) %>
        </dd>

        <dt class="col-sm-4">Deposit</dt>
        <dd class="col-sm-8">
          <%= number_to_currency(@listing.deposit, unit: "$", precision: 0) %>
        </dd>

        <dt class="col-sm-4">Available from</dt>
        <dd class="col-sm-8"><%= @listing.availability_date.strftime("%d/%m/%Y") %></dd>

        <dt class="col-sm-4">Minimum stay</dt>
        <dd class="col-sm-8"><%= @listing.minimum_stay %> months</dd>

        <dt class="col-sm-4">Furnished</dt>
        <dd class="col-sm-8"><%= @listing.furnished? ? "Yes" : "No" %></dd>

        <dt class="col-sm-4">Private bathroom</dt>
        <dd class="col-sm-8"><%= @listing.private_bathroom? ? "Yes" : "No" %></dd>

        <dt class="col-sm-4">Status</dt>
        <dd class="col-sm-8"><%= @listing.status.humanize %></dd>
      </dl>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h3 class="h5">Property</h3>

          <p><strong>Address:</strong> <%= @listing.property.address %></p>
          <p><strong>Type:</strong> <%= @listing.property.property_type %></p>
          <p><strong>Bedrooms:</strong> <%= @listing.property.bedrooms %></p>
          <p><strong>Bathrooms:</strong> <%= @listing.property.bathrooms %></p>

          <%= link_to "View property",
                      property_path(@listing.property),
                      class: "btn btn-outline-primary" %>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-5">
    <h2>Amenities</h2>

    <% if @listing.property.amenities.any? %>
      <div class="d-flex flex-wrap gap-2">
        <% @listing.property.amenities.each do |amenity| %>
          <span class="badge text-bg-secondary">
            <%= amenity.name %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted">No amenities registered.</p>
    <% end %>
  </section>

  <section class="mt-5">
    <h2>Property reviews</h2>

    <% if @reviews.any? %>
      <% @reviews.each do |review| %>
        <div class="card mb-3">
          <div class="card-body">
            <h5>
              <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
            </h5>

            <p><%= review.comment %></p>

            <small class="text-muted">
              <%= review.visit.application.seeker.name %>
            </small>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted">This property has no reviews yet.</p>
    <% end %>
  </section>
</div>