<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Webtech Roomies" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
      <div class="container">
        <%= link_to "Roomies", root_path, class: "navbar-brand fw-bold" %>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#roomiesNavbar"
                aria-controls="roomiesNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="roomiesNavbar">
          <ul class="navbar-nav ms-auto">


              <% if current_user&.moderator? %>
                <li class="nav-item">
                  <%= link_to "Reports",
                        reports_path,
                        class: "nav-link" %>
                </li>
              <% end %>


            <li class="nav-item">
              <%= link_to "Rooms", listings_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Properties", properties_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Neighborhoods", neighborhoods_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Applications", applications_path, class: "nav-link" %>
            </li>
                        
            <li class="nav-item">
              <%= link_to "Amenities",
                          amenities_path,
                          class: "nav-link" %>
            </li>

          </ul>
            
          <% if current_user %>
            <span class="navbar-text text-white ms-lg-3">
              <%= current_user.name %>
            </span>

            <%= link_to "My Profile",
              edit_profile_path,
              class: "nav-link text-light m2-3 m3-2" %>

            <%= button_to "Sign out",
                  session_path,
                  method: :delete,
                  class: "btn btn-outline-light btn-sm ms-lg-3",
                  form: { class: "d-inline" } %>
          <% else %>
            <%= link_to "Sign in",
                  new_session_path,
                  class: "btn btn-outline-light btn-sm ms-lg-3" %>

            <%= link_to "Sign up",
                  new_registration_path,
                  class: "btn btn-primary btn-sm ms-lg-2" %>
          <% end %>

        </div>
      </div>
    </nav>

    
    <main class="flex-grow-1">

      <% if notice.present? %>
        <div class="container mt-3">
          <div class="alert alert-success" role="alert">
            <%= notice %>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="container mt-3">
          <div class="alert alert-danger" role="alert">
            <%= alert %>
          </div>
        </div>
      <% end %>

  <%= yield %>
</main>


    <footer class="bg-dark text-light py-4 mt-auto">
      <div class="container text-center">
        <p class="mb-1 fw-bold">Roomies</p>
        <p class="mb-0 text-secondary">
          Find a room. Meet your roomies. Feel at home.
        </p>
      </div>
    </footer>
  </body>
</html>
