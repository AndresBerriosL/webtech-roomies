
<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Neighborhoods</h1>

    <%= link_to "New Neighborhood",
                new_neighborhood_path,
                class: "btn btn-primary" %>
  </div>

  <% if @neighborhoods.any? %>
    <div class="list-group">
      <% @neighborhoods.each do |neighborhood| %>
        <%= link_to neighborhood_path(neighborhood),
                    class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>

          <span><%= neighborhood.name %></span>

          <span class="badge text-bg-primary rounded-pill">
            <%= neighborhood.properties.size %> properties
          </span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      There are no neighborhoods registered.
    </div>
  <% end %>
</div>
