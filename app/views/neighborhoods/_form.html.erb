
<%= form_with model: neighborhood do |form| %>

  <% if neighborhood.errors.any? %>
    <div class="alert alert-danger">
      <h5>Please correct the following errors:</h5>
      <ul class="mb-0">
        <% neighborhood.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>

    <%= form.text_field :name,
          class: "form-control",
          placeholder: "Enter neighborhood name",
          required: true %>

    <% neighborhood.errors.full_messages_for(:name).each do |message| %>
      <div class="text-danger small mt-1">
        <%= message %>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", neighborhoods_path,
          class: "btn btn-outline-secondary" %>
  </div>

<% end %>
