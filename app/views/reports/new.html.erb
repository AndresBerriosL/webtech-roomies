
<div class="container py-5" style="max-width: 650px;">
  <h1 class="mb-4">Report Listing</h1>

  <div class="alert alert-info">
    <strong>Property:</strong>
    <%= @listing.property.address %>

    <p class="mb-0 mt-2">
      Please explain why you are reporting this listing.
    </p>
  </div>

  <%= form_with model: [@listing, @report] do |f| %>
    <% if @report.errors.any? %>
      <div class="alert alert-danger">
        <%= @report.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :reason, "Reason for reporting",
                  class: "form-label" %>

      <%= f.text_area :reason,
            class: "form-control",
            rows: 5,
            required: true,
            placeholder: "Describe the problem..." %>
    </div>

    <div class="d-flex gap-2">
      <%= f.submit "Submit Report",
            class: "btn btn-danger" %>

      <%= link_to "Cancel",
            listing_path(@listing),
            class: "btn btn-outline-secondary" %>
    </div>
  <% end %>
</div>
