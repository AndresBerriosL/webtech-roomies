
<div class="container py-5">
  <h1>Review property</h1>

  <p class="text-muted">
    <%= @visit.application.listing.property.address %>
  </p>

  <%= form_with model: @review,
                url: visit_reviews_path(@visit) do |form| %>

    <% if @review.errors.any? %>
      <div class="alert alert-danger">
        <% @review.errors.full_messages.each do |error| %>
          <p><%= error %></p>
        <% end %>
      </div>
    <% end %>

    <div class="mb-3">
      <%= form.label :rating, "Rating", class: "form-label" %>

      <%= form.select :rating,
            options_for_select((1..5).map { |n| ["#{n} stars", n] }),
            { prompt: "Choose a rating" },
            class: "form-select",
            required: true %>
    </div>

    <div class="mb-3">
      <%= form.label :comment, class: "form-label" %>

      <%= form.text_area :comment,
            class: "form-control",
            rows: 5,
            required: true,
            placeholder: "Describe your experience..." %>
    </div>

    <%= form.submit "Submit review", class: "btn btn-primary" %>
  <% end %>
</div>
